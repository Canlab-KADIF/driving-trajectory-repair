<?xml version="1.0"?>
<package format="2">
  <name>driving_trajectory_repair</name>
  <version>1.0.0</version>
  <description>
    Offline repair of broken object-tracking trajectories in recorded ROS bags.
    Re-identifies perception tracks that were dropped and re-issued under a new
    id, and fills the gap with spline-interpolated poses, so that a recording
    can be replayed as a continuous driving scenario.
  </description>

  <maintainer email="youngbo.shim@keti.re.kr">Youngbo Shim</maintainer>
  <author email="youngbo.shim@keti.re.kr">Youngbo Shim</author>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/keti-mobility/driving-trajectory-repair</url>
  <url type="bugtracker">https://github.com/keti-mobility/driving-trajectory-repair/issues</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rosbag</depend>
  <depend>tf</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- Visualisation only: the offline tool builds without it -->
  <depend>jsk_recognition_msgs</depend>

  <depend>eigen</depend>

  <!--
    Not publicly distributed: cyber_perception_msgs carries the recorded
    perception stream. See the Dependencies section of README.md for the
    message field layout, so an equivalent package can be defined locally.
  -->
  <depend>cyber_perception_msgs</depend>

  <test_depend>rosunit</test_depend>
</package>
