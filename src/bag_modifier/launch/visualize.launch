  Inspection in rviz. Play a bag alongside it:
    rosbag play recording_repaired.bag

  x_offset and y_offset are subtracted from every drawn position. Map
  coordinates are UTM metres, which lose precision in the float32 transforms
  rviz uses, so set them to a point near the scene.
-->
<launch>
  <arg name="frame_id" default="map"/>
  <arg name="x_offset" default="0.0"/>
  <arg name="y_offset" default="0.0"/>

  <!-- Predicted poses of tracks that perception dropped -->
  <arg name="run_estimation_visualizer" default="true"/>
  <group if="$(arg run_estimation_visualizer)">
    <node pkg="bag_modifier" type="estimation_visualizer"
          name="estimation_visualizer" output="screen">
      <param name="frame_id" value="$(arg frame_id)"/>
      <param name="x_offset" value="$(arg x_offset)"/>
      <param name="y_offset" value="$(arg y_offset)"/>
      <remap from="obstacles" to="/obstacles"/>
    </node>
  </group>

  <!-- Contents of a repaired or interpolated-only bag -->
  <node pkg="bag_modifier" type="repaired_bag_visualizer"
        name="repaired_bag_visualizer" output="screen">
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="x_offset" value="$(arg x_offset)"/>
    <param name="y_offset" value="$(arg y_offset)"/>
    <remap from="obstacles_modified" to="/obstacles_modified"/>
  </node>
</launch>
