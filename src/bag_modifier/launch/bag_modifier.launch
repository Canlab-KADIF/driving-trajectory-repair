  Repairs one recorded bag. This is a batch tool, not a long-running node:
  it exits once the output bags have been written.

  usage:
    roslaunch bag_modifier bag_modifier.launch bag:=/path/to/recording.bag
-->
<launch>
  <arg name="bag" doc="Path of the recording to repair. Never modified."/>
  <arg name="suffix" default="_repaired"
       doc="Appended to the output bag names."/>
  <arg name="config" default="$(find bag_modifier)/config/bag_modifier.yaml"/>

  <node pkg="bag_modifier" type="bag_modifier" name="bag_modifier"
        args="$(arg bag) $(arg suffix)" output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
  </node>
</launch>
